# Names only. Copy to .env and fill in, or point SO_ENV_FILE at a file that already holds them.
# Nothing in this project prints, logs or stores a key.

# Router (system one). https://console.typesafe.ai
TYPESAFE_API_KEY=

# Family: google
GEMINI_API_KEY=

# Family: anthropic
ANTHROPIC_API_KEY=
# Only needed when the key is not scoped to one workspace.
ANTHROPIC_WORKSPACE_ID=

# Family: openai. Either endpoint works; Azure-hosted GPT counts as the same family.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional
# SO_ENV_FILE=/path/to/another.env
# SO_KEY_ALIASES=ANTHROPIC_API_KEY=NAME_USED_IN_THAT_FILE     # if that file uses different names
# SO_TIMEOUT_S=20
# SO_DOWN=anthropic,jev        # pretend these are unreachable, to rehearse the failure paths
